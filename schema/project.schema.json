{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-workbench project",
  "description": "Contents of .workbench/project.yaml (parsed YAML). Closed vocabulary: unknown keys are rejected so that typos do not silently disappear. Cross-reference rules (unique ids, agent references, deliverable paths) live in the Python validator.",
  "type": "object",
  "required": ["project", "agents", "phases"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "review": {
      "description": "Optional. Project-specific input for the shared reviewer agent. Absent = the reviewer applies its generic baseline only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "description": "Project-relative paths or globs the reviewer may read to cross-check claims (same glob syntax as deliverables). Absolute paths, '~' and '..' are rejected by the validator.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "description": "Domain checks applied in addition to the reviewer's generic baseline.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Unique within checks.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "text": { "type": "string", "minLength": 1 },
              "phases": {
                "description": "Phase ids the check applies to. Omitted = every phase. Each entry must be an existing phase id (validator).",
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "fieldbook": {
      "description": "Optional. Settings for the shared fieldbook-writer agent.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Document title used in chapter headers. Falls back to project.name.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "agents", "deliverables", "gate", "tasks"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "description": "review = waiting for user approval.",
            "enum": ["todo", "doing", "review", "blocked", "done"]
          },
          "agents": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" }
          },
          "deliverables": {
            "description": "Project-relative file paths or globs (`*` within one path segment, `**` across segments). Done is judged by file existence and mtime of the expanded paths.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "gate": { "enum": ["dataset-selection", "phase-end"] },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "status", "agent"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "title": { "type": "string", "minLength": 1 },
                "status": { "enum": ["todo", "doing", "done"] },
                "agent": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Filename-safe identifier (phase ids appear in reviews/<phase>-<n>.json).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    }
  }
}
